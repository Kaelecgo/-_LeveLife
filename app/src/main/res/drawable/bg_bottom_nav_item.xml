<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <inset
            android:insetLeft="@dimen/spacing_small"
            android:insetTop="@dimen/spacing_small"
            android:insetRight="@dimen/spacing_small"
            android:insetBottom="@dimen/spacing_small">

            <shape android:shape="rectangle">
                <solid android:color="@color/app_nav_item_active_bg" />
                <corners android:radius="@dimen/corner_radius_large" />
            </shape>
        </inset>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>