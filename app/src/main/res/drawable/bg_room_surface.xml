<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FBF6EE"
                android:centerColor="#F4E9DA"
                android:endColor="#EEDFCB" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/room_border" />
        </shape>
    </item>

    <item
        android:left="14dp"
        android:top="18dp"
        android:right="14dp"
        android:bottom="112dp">
        <shape>
            <solid android:color="#F7EFD9" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item
        android:left="14dp"
        android:top="126dp"
        android:right="14dp"
        android:bottom="16dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#EDC9D7"
                android:endColor="#DFA8BE" />
            <corners
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp"
                android:topLeftRadius="6dp"
                android:topRightRadius="6dp" />
        </shape>
    </item>

    <item
        android:left="28dp"
        android:top="118dp"
        android:right="28dp"
        android:bottom="106dp">
        <shape>
            <solid android:color="#E4C8B2" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</layer-list>
