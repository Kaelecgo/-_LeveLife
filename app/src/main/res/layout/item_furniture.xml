<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    app:cardBackgroundColor="@color/app_surface_card"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_low">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_medium">

        <ImageView
            android:id="@+id/ivFurnitureIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_with_no_bg512"
            android:contentDescription="@string/content_desc_furniture_icon"/>

        <TextView
            android:id="@+id/tvFurnitureName"
            style="@style/LeveLife.Text.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/placeholder_furniture_name"
            android:layout_marginTop="@dimen/spacing_small"/>

        <TextView
            android:id="@+id/tvFurnitureCategory"
            style="@style/LeveLife.Text.BodySecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:text="@string/tasks_preview_category" />

        <TextView
            android:id="@+id/tvFurniturePrice"
            style="@style/LeveLife.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extrabold"
            android:text="@string/placeholder_furniture_price"
            android:textColor="@color/game_berries"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvFurnitureCurrencyHint"
            style="@style/LeveLife.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:gravity="center"
            android:text="@string/shop_item_currency_berries" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuyFurniture"
            style="@style/LeveLife.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/common_action_buy"
            android:layout_marginTop="@dimen/spacing_small"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
