<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivFurnitureIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_with_no_bg512"
            android:contentDescription="@string/content_desc_furniture_icon"/>

        <TextView
            android:id="@+id/tvFurnitureName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black" android:textColor="@color/fourth_text_logo"
            android:text="@string/placeholder_furniture_name"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvFurniturePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extrabold"
            android:text="@string/placeholder_furniture_price" android:textColor="#FF9800"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnBuyFurniture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black" android:text="@string/btn_buy" android:textColor="@color/black"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>