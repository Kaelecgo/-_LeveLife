<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        android:id="@+id/tvFurnitureSlotPickerTitle"
        style="@style/LeveLife.Text.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inventory_slot_picker_title" />

    <TextView
        android:id="@+id/tvFurnitureSlotPickerMessage"
        style="@style/LeveLife.Text.BodySecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/inventory_slot_picker_message" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:background="@color/app_surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium">

        <ImageView
            android:id="@+id/ivFurniturePreview"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/content_desc_furniture_icon"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_with_no_bg512" />

        <TextView
            android:id="@+id/tvFurniturePreviewName"
            style="@style/LeveLife.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:text="@string/placeholder_furniture_name" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSlotFloor"
        style="@style/LeveLife.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/inventory_slot_floor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSlotWall"
        style="@style/LeveLife.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/inventory_slot_wall" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSlotDesk"
        style="@style/LeveLife.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/inventory_slot_desk" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSlotDecor"
        style="@style/LeveLife.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/inventory_slot_decor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelSlotPicker"
        style="@style/LeveLife.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/inventory_slot_cancel" />
</LinearLayout>
