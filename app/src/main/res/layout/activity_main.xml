<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/zombie_dreams_bg"
    android:padding="4dp"
    tools:context=".controller.MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/headerCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvMainLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_level_default"
                android:textSize="24sp"
                android:fontFamily="@font/nunito_extrabold"
                android:textColor="@color/fourth_text_logo" />

            <FrameLayout
                android:id="@+id/containerProgressBar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_below="@id/tvMainLevel"
                android:layout_marginTop="12dp">

                <ProgressBar
                    android:id="@+id/pbMainXp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="24dp"
                    android:progressDrawable="@drawable/custom_progressbar"
                    android:max="100" />
                <TextView
                    android:id="@+id/tvMainXpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/main_xp_default" android:textSize="12sp" android:fontFamily="@font/nunito_black"
                    android:textColor="@color/black" android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvMainBerries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/containerProgressBar"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito_regular" android:textColor="@color/third_text_logo"
                android:text="@string/main_berries_default" android:textSize="16sp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardRoomContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/headerCardView"
        app:layout_constraintBottom_toTopOf="@+id/includeBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/roomContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/component_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
