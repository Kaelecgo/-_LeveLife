<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".controller.MainActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCardView"
        style="@style/LeveLife.Card.Header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvMainSectionLabel"
                style="@style/LeveLife.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_dashboard_label" />

            <TextView
                android:id="@+id/tvMainLevel"
                style="@style/LeveLife.Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="@string/main_level_default"
                tools:text="Nivel 3" />

            <TextView
                android:id="@+id/tvMainProgressLabel"
                style="@style/LeveLife.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/main_progress_label" />

            <FrameLayout
                android:id="@+id/containerProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <ProgressBar
                    android:id="@+id/pbMainXp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/progress_bar_height"
                    android:max="100"
                    android:minHeight="@dimen/progress_bar_height"
                    android:progress="0"
                    android:progressDrawable="@drawable/custom_progressbar"
                    tools:progress="65" />

                <TextView
                    android:id="@+id/tvMainXpText"
                    style="@style/LeveLife.Text.Progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/main_xp_default"
                    tools:text="65 / 100 XP" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layoutStatsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMainBerries"
                    style="@style/LeveLife.StatChip"
                    android:background="@drawable/bg_stat_chip_berries"
                    android:drawableStart="@drawable/ic_berry_small"
                    android:text="@string/main_berries_short"
                    tools:text="120" />

                <TextView
                    android:id="@+id/tvMainEcoCoins"
                    style="@style/LeveLife.StatChip"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="@drawable/bg_stat_chip_eco"
                    android:drawableStart="@drawable/ic_leaf_small"
                    android:text="@string/main_eco_short"
                    tools:text="40" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardRoomContainer"
        style="@style/LeveLife.Card.Room"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCardView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvRoomTitle"
                style="@style/LeveLife.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_room_title" />

            <TextView
                android:id="@+id/tvRoomSubtitle"
                style="@style/LeveLife.Text.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="@string/main_room_subtitle" />

            <AbsoluteLayout
                android:id="@+id/roomContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivRoomBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_x="0dp"
                    android:layout_y="0dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:scaleX="1.20"
                    android:scaleY="1.20"
                    android:src="@drawable/room_bg_cozy_corner_v2" />

                <ImageView
                    android:id="@+id/ivPlacedWallShowcase"
                    android:layout_width="132dp"
                    android:layout_height="196dp"
                    android:layout_x="80dp"
                    android:layout_y="122dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/content_desc_furniture_icon"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/furn_shelf"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivPlacedBedNook"
                    android:layout_width="178dp"
                    android:layout_height="152dp"
                    android:layout_x="230dp"
                    android:layout_y="245dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/content_desc_furniture_icon"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/furn_bed"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivPlacedRugCenter"
                    android:layout_width="178dp"
                    android:layout_height="118dp"
                    android:layout_x="124dp"
                    android:layout_y="330dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/content_desc_furniture_icon"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/furn_rug"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivPlacedSurfaceLeft"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_x="104dp"
                    android:layout_y="250dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/content_desc_furniture_icon"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/furn_lamp_desk"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivPlacedSurfaceRight"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_x="210dp"
                    android:layout_y="236dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/content_desc_furniture_icon"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/furn_pc_gamer"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivPlacedFloorLeft"
                    android:layout_width="112dp"
                    android:layout_height="132dp"
                    android:layout_x="80dp"
                    android:layout_y="310dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/content_desc_furniture_icon"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/furn_plant_small"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivPlacedFloorRight"
                    android:layout_width="112dp"
                    android:layout_height="132dp"
                    android:layout_x="262dp"
                    android:layout_y="308dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/content_desc_furniture_icon"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/furn_fan_eco"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layoutRoomEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_x="3dp"
                    android:layout_y="161dp"
                    android:background="@drawable/bg_bottom_sheet_surface"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:id="@+id/tvRoomEmptyTitle"
                        style="@style/LeveLife.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/main_room_empty_title" />

                    <TextView
                        android:id="@+id/tvRoomEmptyDescription"
                        style="@style/LeveLife.Text.BodySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:gravity="center"
                        android:maxWidth="240dp"
                        android:text="@string/main_room_empty_description"
                        android:textAlignment="center"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </AbsoluteLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/component_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
