<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    app:cardBackgroundColor="@color/app_surface_card"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_medium">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <CheckBox
            android:id="@+id/cbTaskCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTaskTitle"
            style="@style/LeveLife.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:text="@string/tasks_preview_title"
            app:layout_constraintEnd_toStartOf="@+id/llTaskRewards"
            app:layout_constraintStart_toEndOf="@+id/cbTaskCompleted"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTaskCategory"
            style="@style/LeveLife.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tasks_preview_category"
            android:textColor="@color/brand_green_dark"
            app:layout_constraintStart_toStartOf="@+id/tvTaskTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTaskTitle" />

        <TextView
            android:id="@+id/tvTaskMeta"
            style="@style/LeveLife.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            app:layout_constraintStart_toStartOf="@+id/tvTaskTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTaskCategory" />

        <TextView
            android:id="@+id/tvTaskResetTimer"
            style="@style/LeveLife.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:textColor="@color/third_text_logo"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvTaskTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTaskMeta" />

        <LinearLayout
            android:id="@+id/llTaskRewards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- XP Reward -->
            <ImageView
                android:id="@+id/ivRewardXpIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_xp_small"
                app:tint="@color/highlight" />

            <TextView
                android:id="@+id/tvRewardXp"
                style="@style/LeveLife.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/nunito_black"
                android:text="+10"
                android:textColor="@color/highlight" />

            <!-- Berries Reward -->
            <ImageView
                android:id="@+id/ivRewardBerriesIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_berry_small" />

            <TextView
                android:id="@+id/tvRewardBerries"
                style="@style/LeveLife.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/nunito_black"
                android:text="+5"
                android:textColor="@color/game_berries" />

            <!-- Eco Reward -->
            <ImageView
                android:id="@+id/ivRewardEcoIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_leaf_small" />

            <TextView
                android:id="@+id/tvRewardEco"
                style="@style/LeveLife.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_black"
                android:text="+2"
                android:textColor="@color/brand_green_dark" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
